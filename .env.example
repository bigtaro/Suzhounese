# Qwen3-ASR on Alibaba Cloud Model Studio (DashScope)
# Create a key at https://bailian.console.aliyun.com/
QWEN_ASR_API_KEY=

# Mainland China account:
QWEN_ASR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# International account:
# QWEN_ASR_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

QWEN_ASR_PROVIDER=dashscope
QWEN_ASR_MODEL=qwen3-asr-flash

# Optional local Ollama provider. The web UI lists this alongside DashScope,
# so you can switch models without changing the cloud settings above.
QWEN_ASR_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
QWEN_ASR_OLLAMA_MODEL=frozenlab/qwen3-asr:latest
# QWEN_ASR_OLLAMA_API_KEY=
# QWEN_ASR_OLLAMA_TIMEOUT_MS=300000

# Audio handling. Raise the duration only if your endpoint accepts larger requests.
QWEN_ASR_MAX_AUDIO_MB=20
QWEN_ASR_MAX_DURATION_SEC=300
QWEN_ASR_TIMEOUT_MS=120000

# Keep false when building a faithfully transcribed corpus.
QWEN_ASR_ENABLE_ITN=false

HOST=127.0.0.1
PORT=8787
